# Chess-Bot Environment Variables Example
# Copy this file to .env.local and fill in your keys. Never commit .env.local!

# Optional LLM API Key (used in Phase 5 for coaching explanations)
NEXT_PUBLIC_LLM_PROVIDER=
LLM_API_KEY=

# Supabase Auth & Database (used in Phase 6)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
